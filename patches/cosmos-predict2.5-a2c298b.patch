diff --git a/cosmos_predict2/_src/predict2/inference/video2world.py b/cosmos_predict2/_src/predict2/inference/video2world.py
index 4129bc0..512354a 100644
--- a/cosmos_predict2/_src/predict2/inference/video2world.py
+++ b/cosmos_predict2/_src/predict2/inference/video2world.py
@@ -557,6 +557,24 @@ class Video2WorldInference:
                 )
         elif isinstance(input_path, torch.Tensor):
             vid_input = input_path
+            # SO-100 provides one clean frame plus a 15-action horizon (16
+            # pixel frames). WAN2.1 requires 17 pixel frames for state_t=5.
+            # Add only synthetic zero tail frames here; the local inference
+            # wrapper removes the synthetic decoded tail before submission.
+            if vid_input.shape[2] < model_required_frames:
+                pad_frames = model_required_frames - vid_input.shape[2]
+                padding = torch.zeros(
+                    vid_input.shape[0],
+                    vid_input.shape[1],
+                    pad_frames,
+                    vid_input.shape[3],
+                    vid_input.shape[4],
+                    dtype=vid_input.dtype,
+                    device=vid_input.device,
+                )
+                vid_input = torch.cat([vid_input, padding], dim=2)
+            elif vid_input.shape[2] > model_required_frames:
+                vid_input = vid_input[:, :, :model_required_frames]
         else:
             raise ValueError(f"Unsupported input_path type: {type(input_path)}")
 
